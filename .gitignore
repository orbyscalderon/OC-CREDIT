# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment — NEVER commit
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code (config/tooling local a cada máquina, no del proyecto)
.claude/settings.local.json
.agents/
skills-lock.json

# TypeScript
*.tsbuildinfo

# Vite cache
.vite/
.vercel
.env*
# .env.production SÍ se commitea: no lleva secretos, solo la URL pública del
# backend y el client ID de Google (público por diseño) -- Vite lo necesita
# disponible en el build de Cloudflare, que solo tiene lo que está en git.
!frontend/.env.production

# Backup local de credenciales (keystore, SHA-1, client IDs) -- NUNCA subir.
# ".env*" de arriba no cubre esto porque ahí ".env" es el SUFIJO, no el
# prefijo del nombre.
*.env
!frontend/.env.production
