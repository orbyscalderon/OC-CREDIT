/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pay.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.ocaruta.com https://*.tile.openstreetmap.org https://accounts.google.com; frame-src https://pay.google.com https://accounts.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'
