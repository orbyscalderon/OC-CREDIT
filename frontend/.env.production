# Cargado automáticamente por Vite en `npm run build` (modo production).
# No es secreto -- es la URL pública del backend, visible en cualquier request.
VITE_API_URL=https://api.ocaruta.com

# Client ID de Google Sign-In -- público por diseño (va en el HTML/JS del
# navegador), no es secreto. Debe coincidir con GOOGLE_CLIENT_ID en Railway.
VITE_GOOGLE_CLIENT_ID=1085055865063-lnqimhkarihmtc0mh31srfmh9r33brm0.apps.googleusercontent.com

# Google Pay / Stripe (cobro de suscripción SaaS al tenant, ver GooglePayButton.tsx).
VITE_GOOGLE_PAY_ENV=PRODUCTION
# TODO: agregar cuando se tengan los valores reales -- hasta entonces
# GooglePayButton.tsx cae en sus defaults (Merchant ID de ejemplo de Google,
# publishable key vacía), así que el botón fallará claro en vez de simular
# un cobro que nunca llega a Stripe:
# VITE_GOOGLE_PAY_MERCHANT_ID=   (Google Pay Business Console)
# VITE_STRIPE_PUBLISHABLE_KEY=   (Stripe Dashboard, pk_live_...)
VITE_GOOGLE_PAY_MERCHANT_ID=BCR2DN6D5LZI7HCJ
